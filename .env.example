# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# Used by the backend to connect to PostgreSQL.
# When running via docker-compose, the host is the service name: postgres
DATABASE_URL=postgresql://aipm_user:yourpassword@postgres:5432/aipm

# Required by docker-compose to set the PostgreSQL container password
POSTGRES_PASSWORD=yourpassword

# ─── Redis ────────────────────────────────────────────────────────────────────
# Used for SSE notification pub/sub.
# When running via docker-compose, the host is the service name: redis
REDIS_URL=redis://redis:6379

# ─── Authentication ───────────────────────────────────────────────────────────
# Must be a long, random, secret string.  Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_long_random_string_at_least_48_chars

# ─── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ─── Frontend (Vite build-time) ───────────────────────────────────────────────
# URL the browser uses to call the API.
# In production behind Nginx Proxy Manager, the frontend proxies /api → backend,
# so this should be left as /api (the default).
# For local dev without Docker:  http://localhost:3000
VITE_API_URL=/api

# ─── Backend ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ─── Optional: CORS ──────────────────────────────────────────────────────────
# Set to your public domain if you want explicit CORS allow-listing.
FRONTEND_URL=https://aipm.waresmith.tech
